{
  "name": "ozvision-actor",
  "version": "1.0.0",
  "buildTag": "latest",
  "input": {
    "title": "Ozvision/Daicon CSV Downloader Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
      "aspId": {
        "title": "ASP識別子",
        "type": "string",
        "enum": ["ozvision", "daicon"],
        "description": "対象サイト名"
      },
      "loginId": {
        "title": "ログインID（メールアドレス）",
        "type": "string"
      },
      "password": {
        "title": "パスワード",
        "type": "string",
        "isSecret": true
      },
      "targetAds": {
        "title": "対象広告名配列",
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "required": ["aspId", "loginId", "password", "targetAds"]
  }
}
