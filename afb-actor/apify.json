{
  "name": "afb-actor",
  "version": "1.0.0",
  "buildTag": "latest",
  "input": {
    "title": "AFB CSV Downloader Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
      "loginId": {
        "title": "ログインID",
        "type": "string"
      },
      "password": {
        "title": "パスワード",
        "type": "string",
        "isSecret": true
      },
      "targetAds": {
        "title": "対象案件配列",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "value": {
              "title": "プロモーションID（select option value）",
              "type": "string"
            },
            "label": {
              "title": "案件名",
              "type": "string"
            }
          },
          "required": ["value", "label"]
        },
        "minItems": 1
      }
    },
    "required": ["loginId", "password", "targetAds"]
  }
}
